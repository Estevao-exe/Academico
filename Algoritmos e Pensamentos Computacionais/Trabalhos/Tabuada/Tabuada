#include <stdio.h>
int main(){
    int matriz[1][10];
    int i, j;
    char operador;

    printf("Digite o operador(+,-,*,/):  \n");
    scanf(" %c", &operador);
    if(operador == '+'){
        for(i = 0; i < 1; i++){
            for(j = 1; j <= 10; j++){
                printf("%d %c %d = %d \n", 8, operador, j, 8 + j);
            }
        }
    }else if(operador == '-'){
        for(i = 0; i < 1; i++){
            for(j = 1; j <= 10; j++){
                printf("%d %c %d = %d \n", 8, operador, j, 8 - j);
            }
        }
    }else if(operador == '*'){
        for(i = 0; i < 1; i++){
            for(j = 1; j <= 10; j++){
                printf("%d %c %d = %d \n", 8, operador, j, 8 * j);
            }
        }
    }else if(operador == '/'){
        for(i = 0; i < 1; i++){
            for(j = 1; j <= 10; j++){
                printf("%d %c %d = %d \n", 8, operador, j, 8 / j);
            }
        }
    }
    return 0;
}
