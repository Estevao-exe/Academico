#include <stdio.h>
//cria uma constante onde aparecer TAM, o compilador troca por 5. Se a turma mudar de tamanho, você altera só essa linha
#define TAM 5

//Recebe o array v e a quantidade n. Começa com s = 0 e, a cada volta do for, soma v[i] em s (s += v[i] é o mesmo que s = s + v[i]) No fim, devolve a soma com return
float somartudo(float v[], int n){
    float s = 0;
    int i;
    
    for (i = 0; i < n; i++){
        s += v[i];
    }return  s;
}

//Chama somartudo para obter a soma e divide pela quantidade. É o que a média é: soma ÷ quantidade. Ela reaproveita outra função em vez de repetir o for.
float calcularMedia(float v[], int n){
    return somartudo(v, n) / n;
}

//Começa assumindo que a primeira nota é a maior. Depois olha as outras uma a uma, e sempre que encontra uma nota maior que a guardada, troca. No final, maior tem a maior nota de todas.
float MaiorNota(float v[], int n){
    float maior = v[0];
    int i;
    for(i = 0; i < n; i++){
        if(v[i] > maior){
            maior = v[i];
        }
    }
    return maior;
}

int main(){
    float media, maior;
    float notas[TAM];
    int i;
    int aprovados = 0;
    
    for(i = 0; i < TAM; i++){
        printf("Digite a nota do estudante %d\n", i + 1);
        scanf("%f", &notas[i]);
    }
    
    media = calcularMedia(notas, TAM);
    maior = MaiorNota(notas, TAM);
    
//Mostrar os valores    
    printf("\nNotas cadastradas:\n");
    for (i = 0; i < TAM; i++){
        printf("%.1f  ", notas[i]);
    }
    
//Esse for só conta
    for(i = 0; i < TAM; i++){
        if(notas[i] >= 6.0){
            aprovados++;
        }
    }
    
    printf("\n\nMedia da turma: %.1f\n", media);
    printf("Maior nota: %.1f\n", maior);
    printf("Quantidade de aprovados: %d\n", aprovados);
    return 0;
}
