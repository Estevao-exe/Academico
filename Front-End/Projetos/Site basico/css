body{
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #FFF;
    color: #222;
    transition: 0.5s;
}


.navbar{
    background-color: #2ee8f0;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}


.menu{
    display: flex;
    gap: 25px;
}


.menu a{
    color: #222;
    text-decoration: none;
    font-weight: bold;
}


.menu li{
    list-style: none;
}


#botaTema{
    padding: 10px 15px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background-color: #2563eb;
    color: #FFF;
    font-size: 15px;
}


.conteudo{
    padding: 60px 40px;
}


.conteudo h1{
    font-size: 32px;
}


/* Tema escuro*/


body.escuro{
    background-color: #0f172a;
    color: #FFF;
}


body.escuro .navbar{
    background-color: #1e293b;
}


body.escuro .menu a{
    color:#FFF;
}


body.escuro #botaoTema{
    background-color: #facc15;
    color: #111;
}


/* Cursor */


#cursor{
    width: 25px;
    height: 25px;
    background-color: #00bfff;
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 9999;
}

