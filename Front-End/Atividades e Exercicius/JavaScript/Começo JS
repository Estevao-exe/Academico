//===========Calculatior 5===========================================


 let operação = Number(prompt("Qual operação de 1 a 4 você quer: "));


 let n1 = Number(prompt("Digite o primeiro numero: "));
 let n2 = Number(prompt("Digite o segundo numero: "));




 switch(operação){
     case 1:
         operação = n1 + n2;
         alert("Adição: " + operação);
         break;
     case 2:
         operação = n1 - n2;
         alert("subtração: " + operação);
         break;
     case 3:
         operação = n1 * n2;
         alert("Multiplicação: " + operação);
         break;
     case 4:
         operação = n1 / n2;
         alert("Divisão: " +operação);
         break;
     default:
         alert("Digite um numero entre 1 e 4");
 }


